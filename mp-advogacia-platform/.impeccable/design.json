    {
      "name": "Primary Contact Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Gold visitor-initiated contact action.",
      "html": "<a class=\"ds-primary\" href=\"#contato\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"/></svg>Falar pelo WhatsApp</a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:13px 22px;border:1px solid transparent;border-radius:3px;font-family:var(--sans, Lato, Arial, sans-serif);font-size:14px;font-weight:700;line-height:1.4;letter-spacing:0;text-decoration:none;cursor:pointer;transition:background-color .2s,color .2s;background:var(--gold,#e2c48c);color:var(--deep-blue,#13294f)}.ds-primary:hover{background:#f0d6a6}.ds-primary:focus-visible{outline:3px solid var(--gold-ink,#8f692d);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Header Contact Button",
      "kind": "button",
      "refersTo": "button-header",
      "description": "Compact gold contact action for the header.",
      "html": "<a class=\"ds-header-action\" href=\"#contato\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"/></svg>WhatsApp</a>",
      "css": ".ds-header-action{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:13px 22px;border:1px solid transparent;border-radius:3px;font-family:var(--sans, Lato, Arial, sans-serif);font-size:14px;font-weight:700;line-height:1.4;letter-spacing:0;text-decoration:none;cursor:pointer;transition:background-color .2s,color .2s;min-height:44px;padding:10px 16px;font-size:12px;background:var(--gold,#e2c48c);color:var(--deep-blue,#13294f)}.ds-header-action:hover{background:#f0d6a6}.ds-header-action:focus-visible{outline:3px solid var(--gold-ink,#8f692d);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-header-action{transition:none}}"
    },
    {
      "name": "Outline Contact Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Gold outline contact action on the blue area band.",
      "html": "<div class=\"ds-outline-surface\"><a class=\"ds-outline\" href=\"#contato\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"/></svg>Informações sobre atendimento</a></div>",
      "css": ".ds-outline-surface{background:var(--blue,#203b7e)}.ds-outline{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:13px 22px;border:1px solid transparent;border-radius:3px;font-family:var(--sans, Lato, Arial, sans-serif);font-size:14px;font-weight:700;line-height:1.4;letter-spacing:0;text-decoration:none;cursor:pointer;transition:background-color .2s,color .2s;border-color:var(--gold,#e2c48c);background:transparent;color:var(--gold,#e2c48c);margin-top:26px;transition:none}.ds-outline:hover{background:var(--gold,#e2c48c);color:var(--deep-blue,#13294f)}.ds-outline:focus-visible{outline:3px solid var(--gold,#e2c48c);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-outline{transition:none}}"
    },
    {
      "name": "Desktop Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Compact links with a fine hover underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegação principal\"><a href=\"#escritorio\">O escritório</a><a href=\"#areas\">Áreas de atuação</a><a href=\"#duvidas\">Dúvidas</a><a href=\"#contato\">Contato</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:26px;font-family:var(--sans,Lato,Arial,sans-serif);font-size:13px;letter-spacing:0;color:var(--text,#253754);background:var(--paper,#fafaf7)}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;border-bottom:1px solid transparent;color:inherit;text-decoration:none}.ds-nav a:hover{border-bottom-color:var(--gold-ink,#8f692d)}.ds-nav a:focus-visible{outline:3px solid var(--gold-ink,#8f692d);outline-offset:5px}@media(max-width:820px){.ds-nav{flex-direction:column;align-items:stretch;gap:0;padding:16px 20px;font-size:15px}.ds-nav a{padding:8px 4px}}"
    },
    {
      "name": "Area Bookmark Tab",
      "kind": "custom",
      "refersTo": "area-tab",
      "description": "Desktop bookmark changes to a compact horizontal tab on narrow screens.",
      "html": "<div class=\"ds-tab-surface\"><button class=\"ds-area-tab ds-selected\" type=\"button\" role=\"tab\" aria-selected=\"true\"><span class=\"ds-tab-prefix\">Direito</span><span class=\"ds-tab-label\">Trabalhista</span><span class=\"ds-bookmark-letter\" aria-hidden=\"true\">T</span><span class=\"ds-bookmark-foot\" aria-hidden=\"true\"></span></button><button class=\"ds-area-tab\" type=\"button\" role=\"tab\" aria-selected=\"false\"><span class=\"ds-tab-prefix\">Direito</span><span class=\"ds-tab-label\">Empresarial</span><span class=\"ds-bookmark-letter\" aria-hidden=\"true\">E</span><span class=\"ds-bookmark-foot\" aria-hidden=\"true\"></span></button></div>",
      "css": ".ds-tab-surface{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding-top:8px;background:var(--blue,#203b7e)}.ds-area-tab{position:relative;display:flex;flex-direction:column;align-items:center;min-height:238px;padding:24px 8px 44px;border:1px solid var(--dark-line,#536a91);border-radius:3px 3px 0 0;background:transparent;color:var(--paper,#fafaf7);font-family:var(--sans,Lato,Arial,sans-serif);letter-spacing:0;cursor:pointer;transition:transform .25s}.ds-area-tab.ds-selected{color:var(--blue,#203b7e);background:var(--paper,#fafaf7);border-color:var(--paper,#fafaf7);transform:translateY(-8px)}.ds-area-tab:hover:not(.ds-selected){background:var(--deep-blue,#13294f)}.ds-area-tab:focus-visible{outline:3px solid var(--gold,#e2c48c);outline-offset:5px}.ds-tab-prefix{font-size:12px}.ds-tab-label{font-family:var(--serif,\"EB Garamond\",Georgia,serif);font-size:22px;line-height:1.4;margin-top:3px}.ds-bookmark-letter{font-family:var(--serif,\"EB Garamond\",Georgia,serif);font-style:italic;font-size:88px;line-height:1;color:var(--gold,#e2c48c);margin-top:25px}.ds-selected .ds-bookmark-letter{color:var(--gold-ink,#8f692d)}.ds-bookmark-foot{position:absolute;bottom:16px;width:24px;height:1px;background:currentColor}@media(max-width:820px){.ds-area-tab{min-height:58px;padding:14px 6px}.ds-area-tab.ds-selected{transform:none;border-bottom:3px solid var(--gold,#e2c48c)}.ds-tab-label{font-family:var(--sans,Lato,Arial,sans-serif);font-size:15px;margin:0}.ds-bookmark-letter,.ds-bookmark-foot,.ds-tab-prefix{display:none}}@media(max-width:560px){.ds-area-tab{min-height:48px}.ds-tab-label{font-size:13px}}@media(prefers-reduced-motion:reduce){.ds-area-tab{transition:none}}"
    },
    {
      "name": "FAQ Disclosure",
      "kind": "custom",
      "refersTo": "faq-disclosure",
      "description": "Native disclosure row with a fine rule and rotating drawn chevron.",
      "html": "<div class=\"ds-faq\"><details><summary>Como funciona o atendimento?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><p>O atendimento é realizado online. O primeiro contato pode ser feito pelo WhatsApp, para obter informações e combinar o atendimento com o advogado responsável.</p></details></div>",
      "css": ".ds-faq{border-top:1px solid var(--line,#d5dbe4);font-family:var(--sans,Lato,Arial,sans-serif);letter-spacing:0;background:var(--paper,#fafaf7)}.ds-faq details{border-bottom:1px solid var(--line,#d5dbe4)}.ds-faq summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px 0;min-height:64px;cursor:pointer;color:var(--blue,#203b7e);font-size:16px}.ds-faq summary::-webkit-details-marker{display:none}.ds-faq summary svg{flex-shrink:0;transition:transform .2s}.ds-faq details[open] summary svg{transform:rotate(180deg)}.ds-faq summary:focus-visible{outline:3px solid var(--gold-ink,#8f692d);outline-offset:5px}.ds-faq p{margin:0;font-size:15px;line-height:1.65;color:var(--muted,#536382);padding:0 32px 22px 0}@media(max-width:560px){.ds-faq summary{font-size:15px;padding-block:18px}.ds-faq p{font-size:14px}}@media(prefers-reduced-motion:reduce){.ds-faq summary svg{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Engraved Brasilia",
    "overview": "The engraved architectural world ties Marques Pimenta to Brasilia through blue ink, antique gold and near-white paper. EB Garamond gives the brand and headings a measured literary voice; Lato keeps practical information and controls direct.\n\nThe built page uses flat full-width bands, thin rules and generous separation between compact content groups. Its expression is restrained (ENERGY 2 / RHYTHM 3 / MOTION 1): illustration carries identity, color carries hierarchy, and motion acknowledges interaction.",
    "keyCharacteristics": [
      "Blue ink and antique gold on near-white paper.",
      "Serif brand and headings with sans-serif body and controls.",
      "Flat bands, fine dividers and desktop bookmark-shaped area tabs.",
      "Compact mobile controls and native FAQ disclosures."
    ],
    "rules": [
      {
        "name": "The Contact Gold Rule",
        "body": "Gold marks contact actions, focus on blue surfaces and the bookmark initials; blue remains the structural ink.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use EB Garamond for brand and headings, Lato for body and operational controls. Mobile area tabs switch to Lato for compact scanning.",
        "section": "typography"
      },
      {
        "name": "The Flat Band Rule",
        "body": "Use surface color and fine dividers to separate sections. The implemented system has no box-shadow vocabulary.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing blue, gold and paper roles for new elements.",
      "Do keep headings in EB Garamond and readable copy and controls in Lato.",
      "Do preserve visible focus, keyboard area selection and reduced-motion behavior.",
      "Do adapt bookmark tabs into compact horizontal tabs on narrow screens."
    ],
    "donts": [
      "Don't introduce shadows as a substitute for the current flat band structure.",
      "Don't add card grids, inputs or form styles to this record: none are implemented.",
      "Don't scale typography continuously with viewport width; the build uses fixed breakpoint sizes."
    ]
  }
}
